rules_version = '2';

// Данные админки доступны только вошедшим менеджерам.
// Аккаунты создаются вручную в Firebase Console, самостоятельная регистрация отключена
// (Authentication → Settings → User actions → снять «Enable create (sign-up)»).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
