rules_version = '2';

// Данные админки видят все вошедшие, менять могут только менеджеры.
// Гость портфолио входит под демо-аккаунтом («Переглянути як гість») — только чтение.
// Проверяем по uid, а не по почте: почту аккаунта можно сменить, uid — нет.
// Аккаунты менеджеров создаются вручную в Firebase Console, самостоятельная регистрация отключена
// (Authentication → Settings → User actions → снять «Enable create (sign-up)»).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isManager() {
      return signedIn()
        && request.auth.uid != 'nRwaL4PSysNPd74a3a2zdt0xVyy1'
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if isManager();
    }
  }
}
